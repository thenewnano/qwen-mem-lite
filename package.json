{
  "name": "qwen-mem-lite",
  "version": "7.0.0",
  "description": "Persistent long-term memory for Qwen Code and Claude Code via MCP — captures coding decisions, bugfixes, and context across sessions. Hybrid FTS5 + TF-IDF search with episode batching. Single SQLite DB, no external services. A lighter, lower-cost alternative to claude-mem (episode batching + a smaller model; cost savings are an internal estimate, not a measured benchmark).",
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "bin": {
    "qwen-mem-lite": "./cli.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/thenewnano/qwen-mem-lite.git"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{mjs,js}\"",
    "format:check": "prettier --check \"**/*.{mjs,js}\"",
    "dead-code": "knip",
    "validate:manifests": "node scripts/validate-plugin-manifests.mjs",
    "audit:metrics": "node scripts/audit-metrics.mjs --md",
    "audit:baseline": "node scripts/audit-metrics.mjs --run-tests --md",
    "test": "mkdir -p \"$HOME/.cache/tmp\" && TMPDIR=\"$HOME/.cache/tmp\" vitest run",
    "test:smoke": "mkdir -p \"$HOME/.cache/tmp\" && TMPDIR=\"$HOME/.cache/tmp\" vitest run tests/smoke.test.mjs",
    "test:coverage": "mkdir -p \"$HOME/.cache/tmp\" && TMPDIR=\"$HOME/.cache/tmp\" vitest run --coverage",
    "test:ci-env": "mkdir -p \"$HOME/.cache/tmp\" && CI=true GITHUB_ACTIONS=true FORCE_COLOR=1 TMPDIR=\"$HOME/.cache/tmp\" vitest run",
    "benchmark": "node benchmark/benchmark.mjs",
    "benchmark:gate": "node benchmark/ci-gate.mjs",
    "benchmark:multipliers": "node benchmark/multiplier-discrimination.mjs",
    "benchmark:multipliers:gate": "node benchmark/multiplier-discrimination.mjs --self-check",
    "audit:inventory": "node scripts/audit-metrics.mjs --inventory",
    "audit:deps": "node scripts/audit-metrics.mjs --deps",
    "audit:selfcheck": "node scripts/audit-metrics.mjs --self-check",
    "hooks:install": "git config core.hooksPath .githooks && echo \"core.hooksPath -> .githooks (scripts/pre-commit.sh now runs on every commit)\""
  },
